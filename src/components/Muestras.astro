---
import MuestraCard from "./MuestraCard.astro";

const muestras = [
  {
    numero: "M.01",
    tipo: "GUION YOUTUBE",
    titulo: "Kodak: el gigante que no supo ver el futuro digital",
    descripcion:
      "Storytelling de la caída de Kodak con estructura faceless: hook, tres actos y cierre. Research verificado con fuentes secundarias citables.",
    longitud: "≈ 1.800 palabras",
    imagen: "/img/portada-kodak.webp",
    archivo: "/muestras/guion-kodak.docx",
  },
  {
    numero: "M.02",
    tipo: "GUION YOUTUBE",
    titulo: "La Torre Eiffel: la construcción que París odió antes de amar",
    descripcion:
      "Historia divulgativa con voz narrativa, frases cortas pensadas para TTS y tres ganchos de retención a lo largo del guion.",
    longitud: "≈ 1.700 palabras",
    imagen: "/img/portada-torre-eiffel.webp",
    archivo: "/muestras/guion-torre-eiffel.docx",
  },
  {
    numero: "M.03",
    tipo: "ARTÍCULO SEO",
    titulo: "Café frío en casa: 5 métodos que sí funcionan",
    descripcion:
      "Artículo de gastronomía con keyword principal trabajada en encabezados y meta descripción optimizada. Estructura H1-H2-H3.",
    longitud: "≈ 1.200 palabras",
    imagen: "/img/portada-cafe-frio.webp",
    archivo: "/muestras/articulo-cafe-frio.docx",
  },
  {
    numero: "M.04",
    tipo: "ARTÍCULO SEO",
    titulo: "La regla de los 2 minutos para vencer la procrastinación",
    descripcion:
      "Artículo de productividad con ángulo concreto, ejemplos accionables y palabra clave principal trabajada de forma natural.",
    longitud: "≈ 1.300 palabras",
    imagen: "/img/portada-regla-2-min.webp",
    archivo: "/muestras/articulo-regla-2-minutos.docx",
  },
  {
    numero: "M.05",
    tipo: "COPYS REDES",
    titulo: "Molino de Café · lote para Instagram",
    descripcion:
      "Diez copys para una cafetería con variedad de hooks, formatos (educativa, historia, consejo, pregunta) y CTA por publicación.",
    longitud: "10 piezas",
    imagen: "/img/portada-copys-molino.webp",
    archivo: "/muestras/copys-molino-cafe.docx",
  },
];
---

<section id="muestras" class="muestras" aria-labelledby="muestras-title">
  <div class="container">
    <header class="muestras-header">
      <p class="caption">FIG. 005 · CINCO MUESTRAS</p>
      <h2 id="muestras-title" class="display muestras-title">
        Trabajos reales del portafolio.
      </h2>
      <p class="muestras-intro">
        Cada muestra es un trabajo terminado, sin clientes detrás, hechos
        para mostrar formato y voz. Descárgalos y revisa antes de decidir
        si encajamos.
      </p>
    </header>

    <div class="muestras-grid">
      {muestras.map((m) => <MuestraCard {...m} />)}
    </div>
  </div>
</section>

<style>
  .muestras {
    background: var(--color-surface);
    border-top: 1px solid rgba(26, 26, 26, 0.08);
  }

  .muestras-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3.5rem;
    max-width: 60ch;
  }

  .muestras-title {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    color: var(--color-fg);
    margin: 0;
  }

  .muestras-intro {
    color: var(--color-fg-secondary);
    line-height: 1.65;
    font-size: 1.0625rem;
    margin: 0;
  }

  .muestras-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 720px) {
    .muestras-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .muestras-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    /* Centrar últimas 2 cards en grid de 3 columnas */
    .muestras-grid > :nth-child(4) {
      grid-column-start: 1;
    }
  }
</style>
