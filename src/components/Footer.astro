---
const year = new Date().getFullYear();
---

<footer class="footer" aria-labelledby="footer-title">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img
        src="/img/avatar-jm.webp"
        alt="Avatar JM"
        width="64"
        height="64"
        loading="lazy"
        decoding="async"
        class="footer-avatar"
      />
      <div>
        <p id="footer-title" class="footer-name">Jesús David Montalvo</p>
        <p class="footer-rol">Redactor freelance · Colombia</p>
      </div>
    </div>

    <nav class="footer-nav" aria-label="Enlaces">
      <a href="#sobre">Sobre mí</a>
      <a href="#servicios">Servicios</a>
      <a href="#muestras">Muestras</a>
      <a href="#proceso">Cómo trabajo</a>
      <a href="#contacto">Contacto</a>
    </nav>

    <div class="footer-contacto">
      <p class="caption">FIG. 008 · CONTACTO</p>
      <a href="mailto:jesusmontalvoc15@gmail.com" class="footer-link">
        jesusmontalvoc15@gmail.com
      </a>
      <a
        href="https://www.workana.com/freelancer/jesusmontalvo"
        target="_blank"
        rel="noopener"
        class="footer-link"
      >
        Perfil en Workana
      </a>
    </div>
  </div>

  <div class="container footer-bottom">
    <p class="footer-copy">© {year} · Hecho a mano en Colombia.</p>
    <p class="footer-stack">Astro · Tailwind · Cloudflare Pages</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-surface-inverse);
    color: var(--color-fg-inverse);
    padding-block: 4rem 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (min-width: 760px) {
    .footer-grid {
      grid-template-columns: 1.2fr 1fr 1fr;
      gap: 3rem;
    }
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .footer-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
  }

  .footer-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin: 0 0 0.25rem;
    color: var(--color-fg-inverse);
  }

  .footer-rol {
    margin: 0;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.875rem;
  }

  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer-nav a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color 0.2s ease;
  }

  .footer-nav a:hover {
    color: var(--color-accent);
  }

  .footer-contacto {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer-contacto .caption {
    color: var(--color-accent);
    margin: 0 0 0.4rem;
  }

  .footer-link {
    color: var(--color-fg-inverse);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--color-accent);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 2rem;
  }

  .footer-copy,
  .footer-stack {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.05em;
    margin: 0;
  }
</style>
