---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Jesús Montalvo · Redactor freelance",
  description = "Guiones para YouTube faceless, artículos SEO y copys para redes. Voz humana, research verificado, español. Disponible para proyectos.",
  ogImage = "/og-image.png",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Jesús David Montalvo" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f3ebe2" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Jesús Montalvo" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

    <!-- Cloudflare Web Analytics (cookieless) -->
    <!-- TODO: añadir token tras el primer deploy -->

    <!-- Preload hero banner para LCP -->
    <link rel="preload" as="image" href="/img/banner-cover.webp" fetchpriority="high" />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-[var(--color-surface-inverse)] focus:text-[var(--color-fg-inverse)] focus:px-4 focus:py-2 focus:rounded-md">
      Saltar al contenido
    </a>
    <main id="main">
      <slot />
    </main>
  </body>
</html>
